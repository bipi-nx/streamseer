# Twitch application client ID — from https://dev.twitch.tv/console/apps
# Public by design (implicit OAuth has no secret); safe to commit in .env.
# The app's OAuth Redirect URLs must include every origin you serve from, e.g.
#   http://localhost:5173
#   https://streamseer.vercel.app
# Without this, chat still works — anonymous and read-only.
VITE_TWITCH_CLIENT_ID=
